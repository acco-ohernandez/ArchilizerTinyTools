<Window x:Class="ArchilizerTinyTools.Forms.TitleBlocksListForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ArchilizerTinyTools.Forms"
        mc:Ignorable="d"
        Title="TitleBlocksListForm" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DataGrid x:Name="TitleBlocksDataGrid" Grid.Row="1" 
                  AutoGenerateColumns="False" 
                  CanUserAddRows="False" 
                  CanUserDeleteRows="False" 
                  CanUserReorderColumns="False" 
                  CanUserResizeColumns="False" 
                  CanUserResizeRows="False" 
                  CanUserSortColumns="False" 
                  IsReadOnly="True"
                  ItemsSource="{Binding TitleBlocks}"
                  
                  GridLinesVisibility="None"
                  AlternatingRowBackground="AliceBlue"
                  SelectionMode="Single"
                  EnableColumnVirtualization="False"
                  EnableRowVirtualization="True"
                  Width="auto"
                  Height="auto"
                  MinWidth="300"
                  Margin="10"
                  MouseDoubleClick="dg_MouseDoubleClick" 
                  SelectionChanged="TitleBlocksDataGrid_SelectionChanged"
                  HeadersVisibility="Column"
                  >
            <DataGrid.Columns>
                <DataGridTextColumn Header="Title" Binding="{Binding Title}"/>
                <DataGridTextColumn Header="Title" Binding="{Binding Name}"/>
            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</Window>
