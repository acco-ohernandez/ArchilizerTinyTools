<Window x:Class="ArchilizerTinyTools.Forms.ViewSheets_Form"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ArchilizerTinyTools.Forms"
        mc:Ignorable="d"
        Height="450" 
        Width="550"
        MinWidth="400"
        WindowStartupLocation="CenterScreen"
        Title="Enable Regions" 
        >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <!-- Row [0] -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
            <Label Content="Enable Region YesNo Params on sheets" FontSize="20" FontWeight="Bold" />
        </StackPanel>

        <!-- Row [1] -->
        <!-- DataGrid for displaying title blocks -->
        <DataGrid x:Name="dg_ViewSheets"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False" 
                  CanUserDeleteRows="False" 
                  CanUserReorderColumns="False" 
                  CanUserResizeColumns="True" 
                  CanUserResizeRows="False" 
                  CanUserSortColumns="True" 
                  IsReadOnly="True"
                  ItemsSource="{Binding}"
                  AlternatingRowBackground="AliceBlue"
                  SelectionMode="Extended"
                  EnableColumnVirtualization="False"
                  EnableRowVirtualization="True"
                  MouseDoubleClick="dg_MouseDoubleClick" 
                  SelectionChanged="dg_ViewSheets_SelectionChanged"
                  MinWidth="300"
                  Margin="10"
                  HeadersVisibility="Column">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Sheet Type" Binding="{Binding SheetType}" Width="auto"/>
                <DataGridTextColumn Header="Sheet Name" Binding="{Binding SheetName}" Width="*"/>
            </DataGrid.Columns>

        </DataGrid>

        <!-- OK Button -->
        <Button Grid.Row="2" 
            x:Name="btn_OK" 
            Content="Ok" 
            Width="80"
            Height="30"
            HorizontalAlignment="Center" 
            VerticalAlignment="Center"
            Click="btn_OK_Click" IsEnabled="False"/>

    </Grid>
</Window>
