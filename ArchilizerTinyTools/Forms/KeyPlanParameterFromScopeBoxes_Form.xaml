<Window x:Class="ArchilizerTinyTools.Forms.KeyPlanParameterFromScopeBoxes_Form"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="Key Plan - Visibility Parameters" Height="450" Width="900">
    <Window.Resources>
        <Style TargetType="DataGridRow">
            <Style.Resources>
                <!-- Set the background color for selected rows when the DataGrid is inactive -->
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Cyan"/>
            </Style.Resources>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        
        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Vertical">
            <Label Content="Add Key Plan Visibility Parameters to Title Block" FontSize="20" FontWeight="Bold"/>
            <Label Content="Select which Scope Box names to use as Key Plan Visibility Parameters on the selected Title Block" FontSize="12" />
        </StackPanel>
        

        <!-- Search Field -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,0,10,0">
            <Label Content="Search Scope Boxes:" VerticalAlignment="Center"/>
            <TextBox x:Name="txt_Search" Width="300" Margin="10,0,0,0" 
                     VerticalAlignment="Center" TextChanged="txt_Search_TextChanged"/>
        </StackPanel>

        <!-- DataGrids -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- DataGrid for displaying Scope Box Names-->
            <DataGrid x:Name="dg_ScopeBoxes" 
                      Grid.Column="0"
                      GridLinesVisibility="None"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False" 
                      CanUserDeleteRows="False" 
                      CanUserReorderColumns="False" 
                      CanUserResizeColumns="True" 
                      CanUserResizeRows="False" 
                      CanUserSortColumns="True" 
                      IsReadOnly="True"
                      AlternatingRowBackground="AliceBlue"
                      SelectionMode="Extended"
                      SelectionChanged="dataGrids_SelectionChanged"
                      EnableColumnVirtualization="False"
                      EnableRowVirtualization="True"
                      MinWidth="250"
                      Margin="10"
                      HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Scope Boxes" 
                            Binding="{Binding}" 
                            Width="*"/>
                    <!--<DataGridTextColumn Header="View Name" 
                            Binding="{Binding View.Name}" 
                            Width="*"/>-->
                </DataGrid.Columns>
            </DataGrid>
            
            <!-- DataGrid for displaying Title Block Family Names-->
            <DataGrid x:Name="dg_TitleBlockFamilyName" 
                      Grid.Column="1"
                      GridLinesVisibility="None"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False" 
                      CanUserDeleteRows="False" 
                      CanUserReorderColumns="False" 
                      CanUserResizeColumns="True" 
                      CanUserResizeRows="False" 
                      CanUserSortColumns="True" 
                      IsReadOnly="True"
                      AlternatingRowBackground="AliceBlue"
                      SelectionMode="Single"
                      SelectionChanged="dataGrids_SelectionChanged"
                      EnableColumnVirtualization="False"
                      EnableRowVirtualization="True"
                      MinWidth="300"
                      Margin="10"
                      HeadersVisibility="Column">
                <DataGrid.Columns>
                    <!--<DataGridTextColumn Header="Title Block Name" 
                                        Binding="{Binding TitleBlockName}" 
                                        Width="*"/>-->
                    <DataGridTextColumn Header="Title Block (Single Select)" 
                                        Binding="{Binding FamilyName}" 
                                        Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="10,0,10,0" HorizontalAlignment="Center" >
            <!-- OK Button -->
            <Button x:Name="btn_OK" 
                    Content="OK" 
                    Width="80" Height="30" Margin="5"
                    IsEnabled="False"
                    Click="btn_OK_Click"/>

            <!-- Cancel Button -->
            <Button x:Name="btn_Cancel" 
                    Content="Cancel" 
                    Width="80" Height="30" Margin="5"
                    Click="btn_Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
