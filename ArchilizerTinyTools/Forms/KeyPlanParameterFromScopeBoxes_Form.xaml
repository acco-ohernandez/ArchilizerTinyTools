<Window x:Class="ArchilizerTinyTools.Forms.KeyPlanParameterFromScopeBoxes_Form"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Key Plan - Parameters" Height="450" Width="900">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Label Grid.Row="0" Content="Add Key Plan visibility parameters to Title Block" 
               FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <!-- Search Field -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,0,10,0">
            <Label Content="Search Scope Box:" VerticalAlignment="Center"/>
            <TextBox x:Name="txt_Search" Width="300" Margin="10,0,0,0" 
                     VerticalAlignment="Center" TextChanged="txt_Search_TextChanged"/>
        </StackPanel>

        <!-- DataGrids -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- DataGrid for displaying Scope Box Names-->
            <DataGrid x:Name="dg_ScopeBoxes" 
          Grid.Column="0"
          AutoGenerateColumns="False"
          CanUserAddRows="False" 
          CanUserDeleteRows="False" 
          CanUserReorderColumns="False" 
          CanUserResizeColumns="True" 
          CanUserResizeRows="False" 
          CanUserSortColumns="True" 
          IsReadOnly="True"
          AlternatingRowBackground="AliceBlue"
          SelectionMode="Extended"
          EnableColumnVirtualization="False"
          EnableRowVirtualization="True"
          MinWidth="300"
          Margin="10"
          HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Scope Boxes" 
                            Binding="{Binding}" 
                            Width="*"/>
                    <!--<DataGridTextColumn Header="View Name" 
                            Binding="{Binding View.Name}" 
                            Width="*"/>-->
                </DataGrid.Columns>
            </DataGrid>
            
            <!-- DataGrid for displaying Title Block Family Names-->
            <DataGrid x:Name="dg_TitleBlockFamilyName" 
                      Grid.Column="1"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False" 
                      CanUserDeleteRows="False" 
                      CanUserReorderColumns="False" 
                      CanUserResizeColumns="True" 
                      CanUserResizeRows="False" 
                      CanUserSortColumns="True" 
                      IsReadOnly="True"
                      AlternatingRowBackground="AliceBlue"
                      SelectionMode="Single"
                      EnableColumnVirtualization="False"
                      EnableRowVirtualization="True"
                      MinWidth="300"
                      Margin="10"
                      HeadersVisibility="Column">
                <DataGrid.Columns>
                    <!--<DataGridTextColumn Header="Title Block Name" 
                                        Binding="{Binding TitleBlockName}" 
                                        Width="*"/>-->
                    <DataGridTextColumn Header="Family Name" 
                                        Binding="{Binding FamilyName}" 
                                        Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="10,0,10,0" HorizontalAlignment="Right">
            <!-- OK Button -->
            <Button x:Name="btn_OK" 
                    Content="Ok" 
                    Width="80" Height="30" Margin="5"
                    Click="btn_OK_Click"/>

            <!-- Cancel Button -->
            <Button x:Name="btn_Cancel" 
                    Content="Cancel" 
                    Width="80" Height="30" Margin="5"
                    Click="btn_Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>

